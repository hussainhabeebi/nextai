// NextAi data model.
// Every tenant-owned table carries tenant_id (uuid, indexed) and is protected by
// Postgres Row-Level Security (see migrations/*_rls) keyed on the `app.tenant_id` session variable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  trial
  active
  past_due
  suspended
}

enum Country {
  IN
  AE
}

enum UserRole {
  owner
  staff
  tenant_accountant
}

enum PlatformRole {
  super_admin
  reviewer
  support
}

enum UserStatus {
  invited
  active
  disabled
}

enum DocumentSource {
  whatsapp
  app
}

enum DraftType {
  purchase_invoice
  journal_entry
  sales_invoice
  payment_in
  payment_out
}

enum DraftStatus {
  pending
  confirmed
  posting
  posted
  cancelled
  needs_review
  failed
}

enum PlanCode {
  base
  growth
  pro
}

enum PaymentProviderName {
  stripe
  razorpay
}

enum ActorType {
  user
  admin
  system
  bot
}

enum Channel {
  whatsapp
  app
  admin
  system
}

enum WebhookSource {
  chatwoot
  erpnext
  stripe
}

enum SessionKind {
  app
  admin
}

model Tenant {
  id              String       @id @default(uuid()) @db.Uuid
  name            String
  slug            String       @unique
  country         Country
  currency        String       @db.VarChar(3)
  language        String       @default("en") @db.VarChar(5)
  status          TenantStatus @default(trial)
  erpSiteUrl      String?      @map("erp_site_url")
  erpApiKeyEnc    String?      @map("erp_api_key_enc")
  erpApiSecretEnc String?      @map("erp_api_secret_enc")
  erpWebhookSecretEnc String?  @map("erp_webhook_secret_enc")
  cwAccountId     Int?         @map("cw_account_id")
  cwInboxId       Int?         @unique @map("cw_inbox_id")
  cwBotTokenEnc   String?      @map("cw_bot_token_enc")
  planId          String?      @map("plan_id") @db.Uuid
  settings        Json         @default("{}")
  trialEndsAt     DateTime?    @map("trial_ends_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  plan            Plan?            @relation(fields: [planId], references: [id])
  users           User[]
  documents       Document[]
  drafts          Draft[]
  vendorMappings  VendorMapping[]
  subscriptions   Subscription[]
  usageCounters   UsageCounter[]
  auditLogs       AuditLog[]
  pushSubs        PushSubscription[]
  outbound        OutboundMessage[]

  @@map("tenants")
}

model User {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String?       @map("tenant_id") @db.Uuid
  phone         String?
  email         String?
  name          String
  role          UserRole?
  platformRole  PlatformRole? @map("platform_role")
  passwordHash  String?       @map("password_hash")
  totpSecretEnc String?       @map("totp_secret_enc")
  language      String?       @db.VarChar(5)
  status        UserStatus    @default(active)
  lastLoginAt   DateTime?     @map("last_login_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  tenant        Tenant?       @relation(fields: [tenantId], references: [id])
  drafts        Draft[]
  sessions      Session[]
  webauthn      WebAuthnCredential[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([phone])
  @@index([email])
  @@map("users")
}

model Session {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  tenantId    String?     @map("tenant_id") @db.Uuid
  kind        SessionKind
  refreshHash String      @unique @map("refresh_hash")
  userAgent   String?     @map("user_agent")
  ip          String?
  expiresAt   DateTime    @map("expires_at")
  revokedAt   DateTime?   @map("revoked_at")
  createdAt   DateTime    @default(now()) @map("created_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model WebAuthnCredential {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  credentialId String   @unique @map("credential_id")
  publicKey    String   @map("public_key")
  counter      Int      @default(0)
  transports   String[]
  createdAt    DateTime @default(now()) @map("created_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("webauthn_credentials")
}

model Document {
  id         String         @id @default(uuid()) @db.Uuid
  tenantId   String         @map("tenant_id") @db.Uuid
  r2Key      String         @map("r2_key")
  sha256     String
  mime       String
  pages      Int            @default(1)
  source     DocumentSource
  extracted  Json?
  confidence Float?
  uploadedBy String?        @map("uploaded_by") @db.Uuid
  createdAt  DateTime       @default(now()) @map("created_at")

  tenant     Tenant         @relation(fields: [tenantId], references: [id])
  drafts     Draft[]

  @@unique([tenantId, sha256])
  @@index([tenantId])
  @@map("documents")
}

model Draft {
  id             String      @id @default(uuid()) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  userId         String?     @map("user_id") @db.Uuid
  documentId     String?     @map("document_id") @db.Uuid
  conversationId Int?        @map("conversation_id")
  type           DraftType
  payload        Json
  status         DraftStatus @default(pending)
  confidence     Float?
  erpDoctype     String?     @map("erp_doctype")
  erpName        String?     @map("erp_name")
  error          String?
  reviewedBy     String?     @map("reviewed_by") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  tenant         Tenant      @relation(fields: [tenantId], references: [id])
  user           User?       @relation(fields: [userId], references: [id])
  document       Document?   @relation(fields: [documentId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([status])
  @@map("drafts")
}

model VendorMapping {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  supplierName   String   @map("supplier_name")
  taxId          String?  @map("tax_id")
  expenseAccount String   @map("expense_account")
  taxTemplate    String?  @map("tax_template")
  hits           Int      @default(0)
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant         Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, supplierName])
  @@index([tenantId])
  @@map("vendor_mappings")
}

model Plan {
  id               String   @id @default(uuid()) @db.Uuid
  code             PlanCode @unique
  name             String
  priceMonthly     Json     @map("price_monthly") // { "INR": 999, "AED": 49 }
  currency         String   @default("INR") @db.VarChar(3)
  limits           Json
  providerPriceIds Json     @default("{}") @map("provider_price_ids") // { "stripe": { "INR": "price_..", "AED": "price_.." } }
  active           Boolean  @default(true)

  tenants          Tenant[]

  @@map("plans")
}

model Subscription {
  id                     String              @id @default(uuid()) @db.Uuid
  tenantId               String              @map("tenant_id") @db.Uuid
  provider               PaymentProviderName
  providerCustomerId     String              @map("provider_customer_id")
  providerSubscriptionId String?             @unique @map("provider_subscription_id")
  status                 String
  planCode               PlanCode?           @map("plan_code")
  currentPeriodEnd       DateTime?           @map("current_period_end")
  cancelAtPeriodEnd      Boolean             @default(false) @map("cancel_at_period_end")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")

  tenant                 Tenant              @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([providerCustomerId])
  @@map("subscriptions")
}

model UsageCounter {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  period       String // YYYY-MM
  messages     Int    @default(0)
  ocrPages     Int    @default(0) @map("ocr_pages")
  aiTokens     Int    @default(0) @map("ai_tokens")
  aiCostMicros BigInt @default(0) @map("ai_cost_micros")
  invoicesSent Int    @default(0) @map("invoices_sent")

  tenant       Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, period])
  @@index([tenantId])
  @@map("usage_counters")
}

model AuditLog {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String?   @map("tenant_id") @db.Uuid
  actorId   String?   @map("actor_id") @db.Uuid
  actorType ActorType @map("actor_type")
  channel   Channel
  action    String
  entity    String
  entityId  String?   @map("entity_id")
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at")

  tenant    Tenant?   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

model WebhookEvent {
  id          String        @id @default(uuid()) @db.Uuid
  source      WebhookSource
  externalId  String        @unique @map("external_id")
  tenantId    String?       @map("tenant_id") @db.Uuid
  payload     Json
  processedAt DateTime?     @map("processed_at")
  error       String?
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("webhook_events")
}

model OutboundMessage {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  kind           String // invoice | receipt | reminder | summary | otp | notice
  toPhone        String   @map("to_phone")
  conversationId Int?     @map("conversation_id")
  ref            String?
  status         String   @default("queued")
  error          String?
  createdAt      DateTime @default(now()) @map("created_at")

  tenant         Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@map("outbound_messages")
}

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique
  keys      Json
  createdAt DateTime @default(now()) @map("created_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("push_subscriptions")
}

model FeatureFlag {
  id        String   @id @default(uuid()) @db.Uuid
  key       String
  tenantId  String?  @map("tenant_id") @db.Uuid // null = global default
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([key, tenantId])
  @@map("feature_flags")
}

model MessageTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  key       String // otp | invoice | reminder | receipt | daily_summary | billing_notice
  name      String // WhatsApp approved template name
  language  String   @db.VarChar(5)
  params    String[] // ordered param names
  category  String   @default("UTILITY")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([key, language])
  @@map("message_templates")
}
