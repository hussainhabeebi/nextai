// NextAi data model.
// Every tenant-owned table carries tenant_id (uuid, indexed) and is protected by
// Postgres Row-Level Security (see migrations/*_rls) keyed on the `app.tenant_id` session variable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  trial
  active
  past_due
  suspended
}

enum Country {
  IN
  AE
}

enum UserRole {
  owner
  staff
  tenant_accountant
}

enum PlatformRole {
  super_admin
  reviewer
  support
}

enum UserStatus {
  invited
  active
  disabled
}

enum DocumentSource {
  whatsapp
  app
}

enum DraftType {
  purchase_invoice
  journal_entry
  sales_invoice
  payment_in
  payment_out
}

enum DraftStatus {
  pending
  confirmed
  posting
  posted
  cancelled
  needs_review
  failed
}

enum PlanCode {
  base
  growth
  pro
}

enum PaymentProviderName {
  stripe
  razorpay
}

enum ActorType {
  user
  admin
  system
  bot
}

enum Channel {
  whatsapp
  app
  admin
  system
}

enum WebhookSource {
  chatwoot
  erpnext
  stripe
  leadvyne
}

/// Who owns a lifecycle step. Rules name roles, not people, so reassigning work is a data change.
enum LifecycleRole {
  sales
  accountant
  collections
  onboarding
  qa
  support
  ai_manager
  management
}

/// Who a reminder level goes to: the step owner, the rule's escalation role, the customer, or management.
enum ReminderAudience {
  owner
  escalation
  customer
  management
}

enum LifecycleTimerStatus {
  open
  done
  cancelled
}

enum ApprovalStatus {
  pending
  approved
  rejected
  cancelled
}

enum MeetingStatus {
  scheduled
  done
  cancelled
}

enum SessionKind {
  app
  admin
}

model Tenant {
  id                   String       @id @default(uuid()) @db.Uuid
  name                 String
  slug                 String       @unique
  country              Country
  currency             String       @db.VarChar(3)
  language             String       @default("en") @db.VarChar(5)
  status               TenantStatus @default(trial)
  erpSiteUrl           String?      @map("erp_site_url")
  erpApiKeyEnc         String?      @map("erp_api_key_enc")
  erpApiSecretEnc      String?      @map("erp_api_secret_enc")
  erpWebhookSecretEnc  String?      @map("erp_webhook_secret_enc")
  cwAccountId          Int?         @map("cw_account_id")
  cwInboxId            Int?         @unique @map("cw_inbox_id")
  /// Separate WhatsApp number (Chatwoot inbox) for the team: the virtual office assistant and all staff notifications.
  cwStaffInboxId       Int?         @unique @map("cw_staff_inbox_id")
  cwBotTokenEnc        String?      @map("cw_bot_token_enc")
  /// HMAC secret for the lead-capture webhook (Leadvyne). AES-GCM, AAD = lead_webhook:{tenant id}
  leadWebhookSecretEnc String?      @map("lead_webhook_secret_enc")
  planId               String?      @map("plan_id") @db.Uuid
  settings             Json         @default("{}")
  trialEndsAt          DateTime?    @map("trial_ends_at")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  plan            Plan?              @relation(fields: [planId], references: [id])
  users           User[]
  documents       Document[]
  drafts          Draft[]
  vendorMappings  VendorMapping[]
  subscriptions   Subscription[]
  usageCounters   UsageCounter[]
  auditLogs       AuditLog[]
  pushSubs        PushSubscription[]
  outbound        OutboundMessage[]
  staffMembers    StaffMember[]
  lifecycleRules  LifecycleRule[]
  lifecycleTimers LifecycleTimer[]
  attendance      Attendance[]
  standups        Standup[]
  leaveRequests   LeaveRequest[]
  announcements   Announcement[]
  approvals       Approval[]
  meetings        Meeting[]

  @@map("tenants")
}

model User {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String?       @map("tenant_id") @db.Uuid
  phone         String?
  email         String?
  name          String
  role          UserRole?
  platformRole  PlatformRole? @map("platform_role")
  passwordHash  String?       @map("password_hash")
  totpSecretEnc String?       @map("totp_secret_enc")
  language      String?       @db.VarChar(5)
  status        UserStatus    @default(active)
  lastLoginAt   DateTime?     @map("last_login_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  tenant   Tenant?              @relation(fields: [tenantId], references: [id])
  drafts   Draft[]
  sessions Session[]
  webauthn WebAuthnCredential[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([phone])
  @@index([email])
  @@map("users")
}

model Session {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  tenantId    String?     @map("tenant_id") @db.Uuid
  kind        SessionKind
  refreshHash String      @unique @map("refresh_hash")
  userAgent   String?     @map("user_agent")
  ip          String?
  expiresAt   DateTime    @map("expires_at")
  revokedAt   DateTime?   @map("revoked_at")
  createdAt   DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model WebAuthnCredential {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  credentialId String   @unique @map("credential_id")
  publicKey    String   @map("public_key")
  counter      Int      @default(0)
  transports   String[]
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("webauthn_credentials")
}

model Document {
  id         String         @id @default(uuid()) @db.Uuid
  tenantId   String         @map("tenant_id") @db.Uuid
  r2Key      String         @map("r2_key")
  sha256     String
  mime       String
  pages      Int            @default(1)
  source     DocumentSource
  extracted  Json?
  confidence Float?
  uploadedBy String?        @map("uploaded_by") @db.Uuid
  createdAt  DateTime       @default(now()) @map("created_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  drafts Draft[]

  @@unique([tenantId, sha256])
  @@index([tenantId])
  @@map("documents")
}

model Draft {
  id             String      @id @default(uuid()) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  userId         String?     @map("user_id") @db.Uuid
  documentId     String?     @map("document_id") @db.Uuid
  conversationId Int?        @map("conversation_id")
  type           DraftType
  payload        Json
  status         DraftStatus @default(pending)
  confidence     Float?
  erpDoctype     String?     @map("erp_doctype")
  erpName        String?     @map("erp_name")
  error          String?
  reviewedBy     String?     @map("reviewed_by") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])
  document Document? @relation(fields: [documentId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([status])
  @@map("drafts")
}

model VendorMapping {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  supplierName   String   @map("supplier_name")
  taxId          String?  @map("tax_id")
  expenseAccount String   @map("expense_account")
  taxTemplate    String?  @map("tax_template")
  hits           Int      @default(0)
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, supplierName])
  @@index([tenantId])
  @@map("vendor_mappings")
}

model Plan {
  id               String   @id @default(uuid()) @db.Uuid
  code             PlanCode @unique
  name             String
  priceMonthly     Json     @map("price_monthly") // { "INR": 999, "AED": 49 }
  currency         String   @default("INR") @db.VarChar(3)
  limits           Json
  providerPriceIds Json     @default("{}") @map("provider_price_ids") // { "stripe": { "INR": "price_..", "AED": "price_.." } }
  active           Boolean  @default(true)

  tenants Tenant[]

  @@map("plans")
}

model Subscription {
  id                     String              @id @default(uuid()) @db.Uuid
  tenantId               String              @map("tenant_id") @db.Uuid
  provider               PaymentProviderName
  providerCustomerId     String              @map("provider_customer_id")
  providerSubscriptionId String?             @unique @map("provider_subscription_id")
  status                 String
  planCode               PlanCode?           @map("plan_code")
  currentPeriodEnd       DateTime?           @map("current_period_end")
  cancelAtPeriodEnd      Boolean             @default(false) @map("cancel_at_period_end")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([providerCustomerId])
  @@map("subscriptions")
}

model UsageCounter {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  period       String // YYYY-MM
  messages     Int    @default(0)
  ocrPages     Int    @default(0) @map("ocr_pages")
  aiTokens     Int    @default(0) @map("ai_tokens")
  aiCostMicros BigInt @default(0) @map("ai_cost_micros")
  invoicesSent Int    @default(0) @map("invoices_sent")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, period])
  @@index([tenantId])
  @@map("usage_counters")
}

model AuditLog {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String?   @map("tenant_id") @db.Uuid
  actorId   String?   @map("actor_id") @db.Uuid
  actorType ActorType @map("actor_type")
  channel   Channel
  action    String
  entity    String
  entityId  String?   @map("entity_id")
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

model WebhookEvent {
  id          String        @id @default(uuid()) @db.Uuid
  source      WebhookSource
  externalId  String        @unique @map("external_id")
  tenantId    String?       @map("tenant_id") @db.Uuid
  payload     Json
  processedAt DateTime?     @map("processed_at")
  error       String?
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("webhook_events")
}

model OutboundMessage {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  kind           String // invoice | receipt | reminder | summary | otp | notice
  toPhone        String   @map("to_phone")
  conversationId Int?     @map("conversation_id")
  ref            String?
  status         String   @default("queued")
  error          String?
  createdAt      DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@map("outbound_messages")
}

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique
  keys      Json
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("push_subscriptions")
}

model FeatureFlag {
  id        String   @id @default(uuid()) @db.Uuid
  key       String
  tenantId  String?  @map("tenant_id") @db.Uuid // null = global default
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([key, tenantId])
  @@map("feature_flags")
}

model MessageTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  key       String // otp | invoice | reminder | receipt | daily_summary | billing_notice
  name      String // WhatsApp approved template name
  language  String   @db.VarChar(5)
  params    String[] // ordered param names
  category  String   @default("UTILITY")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([key, language])
  @@map("message_templates")
}

// ---------------- Lead-to-customer lifecycle ----------------

/// Internal team member who receives lifecycle reminders (WhatsApp) and ERPNext assignments.
model StaffMember {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String          @map("tenant_id") @db.Uuid
  name          String
  phone         String // E.164
  erpUser       String?         @map("erp_user") // ERPNext user id (email), used for assignments
  roles         LifecycleRole[]
  active        Boolean         @default(true)
  /// in | out | busy | leave — set from WhatsApp (check-in, "busy", leave) or by the schedulers.
  presence      String          @default("out")
  presenceNote  String?         @map("presence_note")
  presenceAt    DateTime?       @map("presence_at")
  /// Who covers this person's reminders while they are on leave.
  backupStaffId String?         @map("backup_staff_id") @db.Uuid
  /// ERPNext Employee id, for the optional attendance sync.
  erpEmployee   String?         @map("erp_employee")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  timers     LifecycleTimer[]
  attendance Attendance[]
  standups   Standup[]
  leaves     LeaveRequest[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@map("staff_members")
}

/// One step of the playbook (e.g. "lead.first_call"). Editable and switchable from the admin console.
model LifecycleRule {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  key            String
  stage          Int
  name           String
  description    String?
  ownerRole      LifecycleRole @map("owner_role")
  escalationRole LifecycleRole @default(accountant) @map("escalation_role")
  enabled        Boolean       @default(true)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  tenant Tenant           @relation(fields: [tenantId], references: [id])
  levels ReminderLevel[]
  timers LifecycleTimer[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("lifecycle_rules")
}

/// A reminder level of a rule: fires `offsetMinutes` after the timer's anchor (negative = before).
model ReminderLevel {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  ruleId        String           @map("rule_id") @db.Uuid
  level         Int
  offsetMinutes Int              @map("offset_minutes")
  audience      ReminderAudience
  templateKey   String           @default("lifecycle_notice") @map("template_key")
  /// Text with {{placeholders}}; also the fallback when no WhatsApp template is mapped.
  message       String
  enabled       Boolean          @default(true)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  rule LifecycleRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, level])
  @@index([tenantId])
  @@map("reminder_levels")
}

/// A running rule for one ERPNext document (e.g. Lead CRM-LEAD-0001). Closed when the step is done.
model LifecycleTimer {
  id            String               @id @default(uuid()) @db.Uuid
  tenantId      String               @map("tenant_id") @db.Uuid
  ruleId        String               @map("rule_id") @db.Uuid
  doctype       String
  docName       String               @map("doc_name")
  anchorAt      DateTime             @map("anchor_at")
  ownerStaffId  String?              @map("owner_staff_id") @db.Uuid
  customerName  String?              @map("customer_name")
  customerPhone String?              @map("customer_phone")
  context       Json                 @default("{}")
  status        LifecycleTimerStatus @default(open)
  /// Level numbers already sent (or skipped as stale) — makes the scan idempotent.
  sentLevels    Int[]                @default([]) @map("sent_levels")
  completedAt   DateTime?            @map("completed_at")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  rule   LifecycleRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  owner  StaffMember?  @relation(fields: [ownerStaffId], references: [id])

  @@unique([ruleId, doctype, docName])
  @@index([tenantId, status])
  @@index([status, anchorAt])
  @@map("lifecycle_timers")
}

// ---------------- Virtual office ----------------

/// One row per staff member per local working day.
model Attendance {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  staffId    String    @map("staff_id") @db.Uuid
  date       String    @db.VarChar(10) // YYYY-MM-DD, tenant local
  checkInAt  DateTime? @map("check_in_at")
  checkOutAt DateTime? @map("check_out_at")
  late       Boolean   @default(false)
  note       String?
  erpSynced  Boolean   @default(false) @map("erp_synced")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  staff  StaffMember @relation(fields: [staffId], references: [id])

  @@unique([staffId, date])
  @@index([tenantId, date])
  @@map("attendance")
}

/// Daily stand-up: plan and blockers at check-in, done and handover at check-out.
model Standup {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  staffId      String   @map("staff_id") @db.Uuid
  date         String   @db.VarChar(10)
  plan         String?
  blockers     String?
  done         String?
  handover     String?
  handoverToId String?  @map("handover_to_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  staff  StaffMember @relation(fields: [staffId], references: [id])

  @@unique([staffId, date])
  @@index([tenantId, date])
  @@map("standups")
}

model LeaveRequest {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  staffId   String         @map("staff_id") @db.Uuid
  fromDate  String         @map("from_date") @db.VarChar(10)
  toDate    String         @map("to_date") @db.VarChar(10)
  reason    String?
  status    ApprovalStatus @default(pending)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  staff  StaffMember @relation(fields: [staffId], references: [id])

  @@index([tenantId, fromDate])
  @@map("leave_requests")
}

model Announcement {
  id           String          @id @default(uuid()) @db.Uuid
  tenantId     String          @map("tenant_id") @db.Uuid
  fromStaffId  String?         @map("from_staff_id") @db.Uuid // null = admin console
  roles        LifecycleRole[] @default([]) // empty = everyone
  text         String
  recipientIds String[]        @default([]) @map("recipient_ids")
  ackIds       String[]        @default([]) @map("ack_ids")
  createdAt    DateTime        @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@map("announcements")
}

/// Approvals answered on WhatsApp ("approve 12" / "reject 12 reason") or in the admin console.
model Approval {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  code          Int // short number typed on WhatsApp, unique per tenant
  kind          String // leave | discount | refund | expense | other
  title         String
  details       String?
  amount        String?
  ref           String? // e.g. leave request id
  requestedById String?        @map("requested_by_id") @db.Uuid
  approverRole  LifecycleRole  @default(management) @map("approver_role")
  status        ApprovalStatus @default(pending)
  decidedBy     String?        @map("decided_by") // staff id or "admin:<id>"
  decisionNote  String?        @map("decision_note")
  decidedAt     DateTime?      @map("decided_at")
  createdAt     DateTime       @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("approvals")
}

model Meeting {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  code         Int
  title        String
  startsAt     DateTime      @map("starts_at")
  durationMin  Int           @default(30) @map("duration_min")
  organizerId  String?       @map("organizer_id") @db.Uuid
  attendeeIds  String[]      @default([]) @map("attendee_ids")
  status       MeetingStatus @default(scheduled)
  notes        String?
  taskNames    String[]      @default([]) @map("task_names")
  remindedAt   DateTime?     @map("reminded_at")
  notesAskedAt DateTime?     @map("notes_asked_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@index([tenantId, startsAt])
  @@map("meetings")
}
