---
interface Props { title: string; description?: string }
const { title, description = 'NextAi is your accountant on WhatsApp. Send bills, voice notes and instructions — we keep your books, send invoices and chase payments. GST (India) and VAT/Corporate Tax (UAE) ready.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0E7A6B" />
    <link rel="icon" href="/app-icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/logo-primary.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Nunito:wght@800&display=swap" rel="stylesheet" />
    <style is:global>
      :root { --teal: #0E7A6B; --teal-d: #0A5E52; --amber: #F29F12; --ink: #111816; --muted: #5f6b67; --bg: #F6F8F7; --line: #E2E8E6; --card: #fff; }
      @media (prefers-color-scheme: dark) { :root { --ink: #ECF2F0; --muted: #9AA8A4; --bg: #0A0F0E; --line: #2A3633; --card: #141C1A; } }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body { margin: 0; font-family: Inter, system-ui, sans-serif; color: var(--ink); background: var(--bg); line-height: 1.55; -webkit-font-smoothing: antialiased; }
      a { color: inherit; }
      .wrap { max-width: 1120px; margin: 0 auto; padding: 0 20px; }
      .brand { font-family: Nunito, Inter, sans-serif; font-weight: 800; letter-spacing: -0.02em; }
      .next { color: var(--teal); } .ai { color: var(--amber); }
      .btn { display: inline-flex; align-items: center; gap: 8px; min-height: 48px; padding: 0 22px; border-radius: 14px; font-weight: 600; text-decoration: none; border: 0; cursor: pointer; font-size: 16px; }
      .btn-primary { background: var(--teal); color: #fff; } .btn-primary:hover { background: var(--teal-d); }
      .btn-amber { background: var(--amber); color: #111; }
      .btn-ghost { border: 1px solid var(--line); background: var(--card); }
      h1, h2, h3 { line-height: 1.15; letter-spacing: -0.02em; }
      .muted { color: var(--muted); }
      .card { background: var(--card); border: 1px solid var(--line); border-radius: 20px; padding: 24px; }
      :focus-visible { outline: 2px solid var(--teal); outline-offset: 2px; }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
