---
import Layout from '../layouts/Layout.astro';
import {config} from '../config';
const {lang='en'}=Astro.props;
const features=[['receipt','Bills & expenses recorded','That bill in your pocket? Send it. We’ll take it from there.'],['send','Invoices sent on WhatsApp','Send your customers an invoice without opening a spreadsheet.'],['bell','A friendly nudge to get paid','Payment reminders, so you don’t have to keep chasing.'],['chart','Your day, in one summary','Know what came in, what went out and what’s left.'],['check','GST / VAT & Corporate Tax ready','Your books organised for India or the UAE.'],['chat','Answers in everyday language','Just ask: “What’s my profit this month?”']];
const faqs=[['Do I need to learn software?','No. Send bills, voice notes and questions on WhatsApp. We take care of your books.'],['Is my data safe?','Your books are kept private, with encrypted data and access limited to authorised people. You approve entries and can export your records.'],['Who files my GST/VAT?','Filing is handled through partner tax professionals on the Pro plan. We confirm the scope, fees and your approval before any filing.'],['What if the AI makes a mistake?','You can review and approve every entry. Flag anything that looks wrong in the chat. A real accountant reviews your books; Pro includes dedicated accountant review and filing support.'],['Can my staff use it?','Yes. The Business and Pro plans include team access, so your staff can send bills while you stay in control.'],['How do I cancel?','Message us on WhatsApp to cancel anytime. You can export your books before you leave. No card is needed for the trial.']];
const paths={receipt:'M7 3h10v18l-3-2-2 2-2-2-3 2V3Zm3 5h4m-4 4h4',send:'m3 4 18 8-18 8 4-8-4-8Zm4 8h14',bell:'M6 9a6 6 0 0 1 12 0v6l2 3H4l2-3V9Zm4 12h4',chart:'M4 4v16h16M8 15l4-5 4 2 4-7',check:'m5 12 4 4L19 6',chat:'M20 11a8 8 0 0 1-8 8H5l-3 3V11a9 9 0 0 1 18 0ZM7 10h8m-8 4h5'};
const structured=[{'@context':'https://schema.org','@type':'Organization',name:'NextAi Accountant',url:'https://nextaierp.com',parentOrganization:{'@type':'Organization',name:'Aiingo Technologies'}},{'@context':'https://schema.org','@type':'SoftwareApplication',name:'NextAi Accountant',applicationCategory:'BusinessApplication',operatingSystem:'WhatsApp',description:'Accounting-as-a-service on WhatsApp for small businesses in India and the UAE.'},{'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))}];
---
<Layout lang={lang}>
<script type="application/ld+json" set:html={JSON.stringify(structured)}/>
<header><div class="container nav"><a class="brand" href="/" aria-label="NextAi home"><span class="logo-primary" role="img" aria-label="NextAi"></span><span class="brand-product"> / Accountant</span></a><div class="nav-actions"><label class="sr-only" for="language">Language</label><select id="language" aria-label="Language"><option value="en" selected={lang==='en'}>English</option><option value="ml" selected={lang==='ml'}>മലയാളം</option><option value="ar" selected={lang==='ar'}>العربية</option></select><button class="button small" data-signup>Start free <span aria-hidden="true">↗</span></button></div></div></header>
<main id="main">
<section class="hero"><div class="container hero-grid"><div class="hero-copy"><p class="eyebrow"><span class="status-dot"></span> LESS PAPERWORK. MORE BUSINESS.</p><h1 data-i18n="hero.title">Your accounts team<br/>on <span class="underline-word">WhatsApp.</span></h1><p class="hero-description" data-i18n="hero.description">Send the bill. We do the books,<br class="desktop"/> invoices and GST/VAT.<br/><strong>No software to learn.</strong></p><div class="hero-actions"><button class="button primary" data-signup>Start on WhatsApp <span aria-hidden="true">↗</span><small>Free for 14 days</small></button><a class="text-link" href="#how">See how it works <span aria-hidden="true">↓</span></a></div><p class="trust">No card needed · Cancel anytime · Your data stays private</p><div class="owner-note"><span class="note-icon" aria-hidden="true">↳</span><p>For the owner who wears every hat.<br/><strong>Let us wear the accounts one.</strong></p></div></div>
<div class="hero-art" aria-label="Illustrative chat: a bill sent and recorded"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="floating-label label-top"><span>✓</span> One less thing on your mind</div><div class="phone"><div class="phone-speaker"></div><div class="chat-header"><span class="chat-avatar logo-app" aria-hidden="true"></span><div><strong>NextAi Accountant</strong><small><i></i> Your accounts team</small></div><span aria-hidden="true">•••</span></div><div class="chat-date">TODAY · ILLUSTRATIVE DEMO</div><div class="bubble outgoing"><div class="bill"><span>ABC TRADERS</span><small>TAX INVOICE · 0241</small><div class="bill-lines"></div><p>Subtotal <b>₹4,000</b></p><p>GST <b>₹720</b></p><p class="bill-total">Total <b>₹4,720</b></p></div><span class="chat-time">10:42 <b>✓✓</b></span></div><div class="bubble incoming">Saved ✅<br/><strong>ABC Traders ₹4,720</strong><br/><span class="muted">(GST ₹720)</span><span class="chat-time">10:42</span></div><div class="bubble outgoing question">How’s business today?<span class="chat-time">10:43 <b>✓✓</b></span></div><div class="bubble incoming summary"><strong>Your day, at a glance ☀</strong><p>Money in <b>₹18,500</b></p><p>Money out <b>₹4,720</b></p><div>All caught up. Back to business.</div></div><div class="chat-input">Message your accounts team <span>＋</span></div></div><div class="floating-label label-bottom"><span class="mini-chart">↗</span><div>Your books. Sorted.<small>Just send it. We’ll handle it.</small></div><span class="circle-check">✓</span></div></div></div><div class="container hero-bottom"><span>MADE FOR YOUR KIND OF BUSINESS</span><div>Shops <i>✦</i> Traders <i>✦</i> Cafeterias <i>✦</i> Salons <i>✦</i> Freelancers</div></div></section>
<section class="section" id="how"><div class="container"><div class="section-heading"><p class="eyebrow">YOUR NEW ROUTINE</p><h2>Three steps.<br/>A lot less on your plate.</h2><p>Keep running your business. We’ll keep your books.</p></div><div class="steps">{[['01','↗','Send','Snap the bill or send a voice note on WhatsApp.'],['02','≋','We record','AI reads it. A real accountant checks it.'],['03','✓','You know','Daily summary. Invoices sent. GST/VAT ready.']].map(([n,icon,title,copy])=><article class="step reveal"><div class="step-top"><span class="step-icon">{icon}</span><span>{n}</span></div><h3>{title}</h3><p>{copy}</p></article>)}</div></div></section>
<section class="section services"><div class="container"><div class="section-heading split-heading"><div><p class="eyebrow">CONSIDER IT TAKEN CARE OF</p><h2>Big help.<br/>For small businesses.</h2></div><p>From the first bill of the day to the last payment reminder. All in the chat you already use.</p></div><div class="feature-grid">{features.map(([icon,title,copy])=><article class="feature"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={paths[icon as keyof typeof paths]}/></svg><h3>{title}</h3><p>{copy}</p></article>)}</div></div></section>
<section class="section"><div class="container comparison"><div class="before"><p class="eyebrow">WITHOUT NEXTAI</p><h2>Sound familiar?</h2><ul><li><span>×</span> Bills in a drawer. Some missing.</li><li><span>×</span> GST deadline? Another last-minute rush.</li><li><span>×</span> Chasing customers for payments.</li><li><span>×</span> Your evenings, lost to paperwork.</li></ul></div><div class="after"><p class="eyebrow">WITH NEXTAI</p><h2>A little more peace of mind.</h2><ul><li><span>✓</span> Every bill, in one chat.</li><li><span>✓</span> Books ready. Deadlines in sight.</li><li><span>✓</span> Friendly reminders, sent for you.</li><li><span>✓</span> On time. Organised. Done.</li></ul><span class="handwritten">That’s better.</span></div></div></section>
<section class="section language-section"><div class="container language-grid"><div><p class="eyebrow">NO ACCOUNTING LANGUAGE NEEDED</p><h2>Talk to it<br/>like a person.</h2><p>Type it. Say it. Send a photo.<br/>English, മലയാളം or العربية.<br/>Your business. Your words.</p><span class="demo-note">Illustrative conversations</span></div><div class="conversation-examples"><div class="example"><span class="lang-label">ENGLISH</span><p>“Who still needs to pay me?”</p><small>Ask about money you’ll receive. Just like that.</small></div><div class="example malayalam"><span class="lang-label">മലയാളം · VOICE NOTE</span><p lang="ml">“ഇന്നത്തെ ചെലവ് എത്രയാണ്?”</p><div class="voice"><span aria-hidden="true">▶</span><span class="wave" aria-hidden="true">▂ ▄ ▆ ▃ ▇ ▅ ▂ ▆ ▄ ▇ ▃ ▅ ▂ ▄ ▆ ▃</span><span>0:08</span></div></div><div class="example arabic" lang="ar" dir="rtl"><span class="lang-label">العربية</span><p>“كم ربحي هذا الشهر؟”</p><small>Ask: “What’s my profit this month?”</small></div></div></div></section>
<section class="section accountant"><div class="container accountant-inner"><div class="accountant-symbol" aria-hidden="true"><span>✦</span><span>✓</span></div><div><p class="eyebrow">SMART TECHNOLOGY. REAL PEOPLE.</p><h2>AI does the busywork.<br/>A real accountant has your back.</h2><p>AI reads and organises your bills. A qualified accountant reviews your books. Filing goes through partner tax professionals, with your approval.</p><p class="plan-note">Pro adds dedicated accountant review and filing support.</p></div></div></section>
<section class="section" id="pricing"><div class="container"><div class="section-heading centered"><p class="eyebrow">ONE LESS HIRE. A LOT MORE HELP.</p><h2>Less than the cost<br/>of one accountant.</h2><p>Start free for 14 days. Find the right fit as you grow.</p><div class="country-toggle" role="group" aria-label="Pricing country"><button class="active" data-market="IN" aria-pressed="true">India <span>₹</span></button><button data-market="AE" aria-pressed="false">UAE <span>AED</span></button></div></div><div class="pricing-grid">{[['Starter','A tidy start for your books.',['Bills & expenses recorded','Customer invoices','Simple reports']],['Business','More help for a busier business.',['Everything in Starter','GST/VAT-ready books','Payment reminders','Bank matching','Team access']],['Pro','An accountant in your corner.',['Everything in Business','Dedicated accountant review','Filing through tax partners']]].map(([name,tag,items],i)=><article class:list={['price-card',{popular:i===1}]}>{i===1&&<span class="popular-tag">MOST POPULAR</span>}<h3>{name}</h3><p>{tag}</p><div class="price"><span data-price>[₹]</span><small> / month</small></div><span class="price-note">Price to be confirmed</span><button class:list={['button',{primary:i===1,outlined:i!==1}]} data-signup data-plan={name}>Start free <span aria-hidden="true">↗</span></button><ul>{(items as string[]).map(item=><li><span>✓</span> {item}</li>)}</ul></article>)}</div><p class="pricing-footnote">Prices are placeholders. Final pricing, tax scope and any filing fees will be confirmed before you subscribe.</p></div></section>
<section class="security"><div class="container"><p class="eyebrow">YOUR BUSINESS IS YOUR BUSINESS.</p><div class="security-grid">{[['♧','Encrypted data'],['▣','Your own private books'],['✓','You approve every entry'],['↗','Export anytime']].map(([icon,text])=><div><span aria-hidden="true">{icon}</span><strong>{text}</strong></div>)}</div></div></section>
<section class="section"><div class="container faq-grid"><div><p class="eyebrow">A FEW THINGS YOU MAY BE WONDERING</p><h2>Good questions.<br/>Simple answers.</h2><p>Still have one?<br/><a class="text-link" data-chat href="#">Let’s talk on WhatsApp ↗</a></p></div><div class="faqs">{faqs.map(([q,a])=><details><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div></div></section>
<section class="final-cta"><div class="container"><span class="eyebrow">YOUR TIME IS BETTER SPENT ELSEWHERE.</span><h2>Stop doing accounts.<br/><span>Start on WhatsApp.</span></h2><button class="button primary" data-signup>Start my free 14 days <span aria-hidden="true">↗</span></button><p>No card. No new software. Just a message.</p></div><span class="final-star" aria-hidden="true">✳</span></section>
</main>
<footer><div class="container footer-top"><div><a class="brand" href="/"><span class="logo-stacked" role="img" aria-label="NextAi"></span></a><p>Your accounts team on WhatsApp.</p><small>A product by Aiingo Technologies</small></div><div><span class="footer-label">SAY HELLO</span><a href={`mailto:${config.email}`}>{config.email}</a><a data-chat href="#">Message us on WhatsApp ↗</a></div><div><span class="footer-label">THE DETAILS</span><a href="/privacy">Privacy policy</a><a href="/terms">Terms of service</a></div></div><div class="container footer-bottom"><span>© {new Date().getFullYear()} NextAi Accountant</span><span>Made for India & the UAE.</span></div></footer>
<div class="mobile-cta" hidden><button class="button primary" data-signup>Start free on WhatsApp <span aria-hidden="true">↗</span></button></div>
<dialog id="signup" aria-labelledby="signup-title"><div class="modal"><button class="close" aria-label="Close signup">×</button><span class="eyebrow">LET’S TAKE ACCOUNTS OFF YOUR PLATE.</span><h2 id="signup-title">A fresh start.<br/>In one message.</h2><p>14 days free. No card. No password.</p><form id="signup-form" novalidate data-endpoint={config.signupEndpoint}><label for="business">Business name</label><input id="business" name="businessName" autocomplete="organization" required maxlength="120" placeholder="Your business name" aria-describedby="business-error"/><span class="field-error" id="business-error"></span><label for="phone">WhatsApp number</label><div class="phone-field"><label class="sr-only" for="dial">Country calling code</label><select id="dial" name="dial"><option value="91">IN +91</option><option value="971">AE +971</option></select><input id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel-national" required placeholder="Your mobile number" aria-describedby="phone-error"/></div><span class="field-error" id="phone-error"></span><label for="country">Country</label><select id="country" name="country"><option value="IN">India</option><option value="AE">UAE</option></select><p class="form-legal">By starting, you agree to our <a href="/terms">terms</a> and <a href="/privacy">privacy policy</a>, and to receive setup messages on WhatsApp.</p><button type="submit" class="button primary">Start free <span aria-hidden="true">↗</span></button></form><div id="form-status" role="status" aria-live="polite"></div><div class="fallback"><span>Prefer to just chat?</span><a data-chat href="#">Message us on WhatsApp ↗</a><small class="setup-notice">Demo setup: the business WhatsApp number is not connected yet.</small></div></div></dialog>
<script>import '../scripts/main';</script>
</Layout>
