---
import '../styles/global.css';
const {title='NextAi Accountant — Your accounts team on WhatsApp',description='Send the bill. We do the books, invoices and GST/VAT. No software to learn. Try NextAi Accountant free for 14 days.',lang='en'}=Astro.props;
---
<!doctype html><html lang={lang} dir={lang==='ar'?'rtl':'ltr'}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={new URL(Astro.url.pathname,Astro.site)}/><meta name="theme-color" content="#164d43"/><link rel="icon" type="image/png" href="/favicon.png"/><meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={Astro.url}/><meta property="og:image" content="https://nextaierp.com/og.png"/><meta name="twitter:card" content="summary_large_image"/>{['en','ml','ar'].map(l=><link rel="alternate" hreflang={l} href={`https://nextaierp.com/${l==='en'?'':l+'/'}`}/>)}<link rel="alternate" hreflang="x-default" href="https://nextaierp.com/"/></head><body><a class="skip" href="#main">Skip to content</a><slot/></body></html>
