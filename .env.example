# ---- Runtime ----
NODE_ENV=development
PORT=8090
APP_URL=https://app.nextaierp.com
API_URL=https://api.nextaierp.com
# Comma separated CORS allowlist (defaults to APP_URL)
CORS_ORIGINS=https://app.nextaierp.com

# ---- Data ----
# Application role (non-superuser, subject to RLS)
DATABASE_URL=postgresql://nextai_app:nextai_app@localhost:5432/nextai
# Owner role used for migrations / seed only (bypasses RLS as table owner)
DATABASE_MIGRATE_URL=postgresql://nextai:nextai@localhost:5432/nextai
REDIS_URL=redis://localhost:6379

# ---- Crypto ----
# 32 bytes, base64 encoded:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
JWT_SECRET=
JWT_REFRESH_SECRET=

# ---- Chatwoot ----
CHATWOOT_BASE_URL=https://app.aiingo.com
CHATWOOT_WEBHOOK_SECRET=
# Comma separated IPs/CIDRs allowed to call /webhooks/chatwoot (empty = disabled check in dev)
CHATWOOT_ALLOWED_IPS=
# Platform-level Chatwoot API token used by provisioning (inbox + agent bot creation)
CHATWOOT_PLATFORM_TOKEN=

# ---- Cloudflare R2 ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nextai

# ---- AI providers (mock | openai | anthropic | google | deepgram ...) ----
AI_VISION_PROVIDER=mock
AI_VISION_API_KEY=
AI_STT_PROVIDER=mock
AI_STT_API_KEY=
AI_LLM_PROVIDER=mock
AI_LLM_API_KEY=

# ---- Stripe ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ---- Provisioner (internal service on the ERPNext host) ----
PROVISIONER_URL=http://10.0.0.2:8099
PROVISIONER_SECRET=

# ---- Admin ----
ADMIN_BOOTSTRAP_EMAIL=admin@nextaierp.com
ADMIN_BOOTSTRAP_PASSWORD=

# ---- Observability ----
SENTRY_DSN=
LOG_LEVEL=info
